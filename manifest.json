{
  "manifest_version": 3,
  "name": "直播通知",
  "description": "实时显示直播关注主播的开播状态，点击跳转直播间",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://live.bilibili.com/*"
      ],
      "js": [
        "lib/bilibili-barrage.js",
        "lib/bilibili-page-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "https://www.douyu.com/*",
    "https://api.live.bilibili.com/*",
    "https://*.bilibili.com/*",
    "https://www.doseeing.com/*"
  ]
}