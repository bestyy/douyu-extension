+
+  // 检查是否已存在
+  const rooms = (await StorageHelper.get('rooms')) || [];
+  if (rooms.some(r => r.roomId === roomId)) {
+    return { ok: false, error: '该房间已在监控列表中' };
+  }
+
+  // 解析主播名
+  const resolveResult = await DouyuAPI.resolveNickname(roomId);
